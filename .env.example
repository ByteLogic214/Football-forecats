# ===== Claves (nunca subir a git; en GitHub van en Secrets) =====
STATS_API_KEY=tu_api_key_de_thestatsapi
ODDS_API_KEY=tu_api_key_de_theoddsapi

# ===== Ligas a cubrir (IDs de TheStatsAPI, ej. comp_3039 = Premier League) =====
COMPETITION_IDS=comp_3039

# ===== TheOddsAPI =====
ODDS_REGIONS=eu,uk
# ODDS_SPORT_KEYS=soccer_epl,soccer_spain_la_liga,soccer_uefa_champs_league

# ===== Modelo =====
SOT_LOOKBACK=5
FORM_WEIGHT=0.60
HOME_BOOST=1.12

# ===== Filtros de valor =====
MIN_EDGE=0.04
MIN_PROB=0.55
MAX_PICKS=8

# ===== Banca =====
BANKROLL=1000
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.03

# ===== Misc =====
# FIXTURE_DATE=2026-09-12   # YYYY-MM-DD; comentado = hoy UTC
